<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_fluxbank-transfer-overview" targetNamespace="https://fluxbank.local/architecture" exporter="FluxBank architecture documentation" exporterVersion="2">
  <bpmn:process id="fluxbank-transfer-overview_client" name="Client" isExecutable="false">
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask1" name="Request: 100 EUR&#10;POST /api/v1/transfers">
      <bpmn:documentation>Bearer JWT. CreateTransferRequest(sourceAccountPublicId, beneficiaryPublicId, amount).</bpmn:documentation>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="fluxbank-transfer-overview_api" name="FluxBank | synchronous API" isExecutable="false">
    <bpmn:laneSet id="fluxbank-transfer-overview_api_lanes">
      <bpmn:lane id="fluxbank-transfer-overview_api_auth" name="API">
        <bpmn:flowNodeRef>fluxbank-transfer-overview_serviceTask2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fluxbank-transfer-overview_exclusiveGateway3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fluxbank-transfer-overview_api_money" name="Finance">
        <bpmn:flowNodeRef>fluxbank-transfer-overview_serviceTask6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fluxbank-transfer-overview_serviceTask7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fluxbank-transfer-overview_serviceTask10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask2" name="Authenticate and authorize&#10;TransferService.createTransfer()">
      <bpmn:documentation>JWT, @Valid DTO, source owner and active beneficiary owner checks. See fluxbank-transfer-entry-detail.bpmn.
Sources: TransferController.createTransfer() — src/main/java/com/fluxbank/transfer/api/TransferController.java:21; TransferService.createTransfer() — src/main/java/com/fluxbank/transfer/application/TransferService.java:59</bpmn:documentation>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="fluxbank-transfer-overview_exclusiveGateway3" name="Local target IBAN?">
      <bpmn:incoming>fluxbank-transfer-overview_Flow4</bpmn:incoming>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow8</bpmn:outgoing>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow4" sourceRef="fluxbank-transfer-overview_serviceTask2" targetRef="fluxbank-transfer-overview_exclusiveGateway3" />
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask6" name="INTERNAL | A → B&#10;InternalTransferProcessor.process()&#10;Debit A / credit B">
      <bpmn:documentation>Separate committed PENDING creation precedes financial processing. TX-FINANCIAL atomically changes balances, completes Transfer and inserts Outbox. See fluxbank-internal-transfer-detail.bpmn.
Sources: InternalTransferProcessor.process() — src/main/java/com/fluxbank/transfer/application/InternalTransferProcessor.java:37</bpmn:documentation>
      <bpmn:incoming>fluxbank-transfer-overview_Flow8</bpmn:incoming>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask7" name="EXTERNAL | A → bank&#10;Reserve → provider → finalize">
      <bpmn:documentation>Reservation commit; HTTP outside DB TX; SUCCESS settles + Outbox, REJECTED releases + FAILED, UNKNOWN keeps PENDING/reserved. See fluxbank-external-transfer-detail.bpmn.
Sources: ExternalTransferReservationService.createPendingAndReserve() — src/main/java/com/fluxbank/transfer/application/ExternalTransferReservationService.java:36; ExternalTransferProcessor.process() — src/main/java/com/fluxbank/transfer/application/provider/ExternalTransferProcessor.java:20; ExternalTransferFinalizationService.complete() — src/main/java/com/fluxbank/transfer/application/ExternalTransferFinalizationService.java:35; ExternalTransferFinalizationService.fail() — src/main/java/com/fluxbank/transfer/application/ExternalTransferFinalizationService.java:57</bpmn:documentation>
      <bpmn:incoming>fluxbank-transfer-overview_Flow9</bpmn:incoming>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow8" sourceRef="fluxbank-transfer-overview_exclusiveGateway3" targetRef="fluxbank-transfer-overview_serviceTask6" name="Yes: INTERNAL" />
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow9" sourceRef="fluxbank-transfer-overview_exclusiveGateway3" targetRef="fluxbank-transfer-overview_serviceTask7" name="No: EXTERNAL" />
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask10" name="Return current transfer state&#10;TransferLifecycleService.getResponse()&#10;HTTP 201; History is asynchronous">
      <bpmn:documentation>Sources: TransferLifecycleService.getResponse() — src/main/java/com/fluxbank/transfer/application/TransferLifecycleService.java:79</bpmn:documentation>
      <bpmn:incoming>fluxbank-transfer-overview_Flow11</bpmn:incoming>
      <bpmn:incoming>fluxbank-transfer-overview_Flow12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow11" sourceRef="fluxbank-transfer-overview_serviceTask6" targetRef="fluxbank-transfer-overview_serviceTask10" />
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow12" sourceRef="fluxbank-transfer-overview_serviceTask7" targetRef="fluxbank-transfer-overview_serviceTask10" />
  </bpmn:process>
  <bpmn:process id="fluxbank-transfer-overview_worker" name="FluxBank | Outbox worker" isExecutable="false">
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask13" name="Poll committed Outbox&#10;OutboxPoller.poll()&#10;Claim → publish → record ACK">
      <bpmn:documentation>Database polling, not a synchronous call from the API. See fluxbank-kafka-outbox-history-detail.bpmn.
Sources: OutboxPoller.poll() — src/main/java/com/fluxbank/outbox/application/OutboxPoller.java:32; OutboxProcessor.process() — src/main/java/com/fluxbank/outbox/application/OutboxProcessor.java:27</bpmn:documentation>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask14" name="Await broker ACK&#10;TransferCompletedKafkaPublisher&#10;.publish()">
      <bpmn:documentation>Sources: TransferCompletedKafkaPublisher.publish() — src/main/java/com/fluxbank/transfer/infrastructure/kafka/TransferCompletedKafkaPublisher.java:25</bpmn:documentation>
      <bpmn:incoming>fluxbank-transfer-overview_Flow15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow15" sourceRef="fluxbank-transfer-overview_serviceTask13" targetRef="fluxbank-transfer-overview_serviceTask14" />
  </bpmn:process>
  <bpmn:process id="fluxbank-transfer-overview_broker" name="Kafka broker" isExecutable="false">
    <bpmn:receiveTask id="fluxbank-transfer-overview_receiveTask16" name="TRANSFER_COMPLETED&#10;fluxbank.transfer-events.v1&#10;Key = transferPublicId">
      <bpmn:documentation>Stable eventId=Outbox.publicId. acks=all. Producer ACK does not mean History has committed.</bpmn:documentation>
    </bpmn:receiveTask>
  </bpmn:process>
  <bpmn:process id="fluxbank-transfer-overview_consumer" name="FluxBank | History consumer" isExecutable="false">
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask18" name="Record History atomically&#10;TransactionHistoryEventProcessor&#10;.process()">
      <bpmn:documentation>TX-HISTORY: marker + INTERNAL DEBIT/CREDIT or EXTERNAL DEBIT. No financial balance updates. See fluxbank-history-consumer-detail.bpmn.
Sources: TransactionHistoryEventProcessor.process() — src/main/java/com/fluxbank/transaction/application/TransactionHistoryEventProcessor.java:20; TransactionHistoryService.createForSnapshot() — src/main/java/com/fluxbank/transaction/application/TransactionHistoryService.java:55</bpmn:documentation>
      <bpmn:outgoing>fluxbank-transfer-overview_Flow21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="fluxbank-transfer-overview_serviceTask19" name="Commit source Kafka offset&#10;Spring Kafka container&#10;RECORD; after DB commit">
      <bpmn:documentation>Not atomic with PostgreSQL. Redelivery is safe through ProcessedEvent marker.</bpmn:documentation>
      <bpmn:incoming>fluxbank-transfer-overview_Flow21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fluxbank-transfer-overview_Flow21" sourceRef="fluxbank-transfer-overview_serviceTask18" targetRef="fluxbank-transfer-overview_serviceTask19" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_fluxbank-transfer-overview">
    <bpmn:documentation>01 | Transfer architecture
Source: current working tree, 2026-11-08. Documentation only; isExecutable=false. Solid arrows = local execution order. Dashed arrows = HTTP/Kafka messages across pools. Green expanded subprocess = Spring database transaction, not BPMN compensation semantics. Red = failure; amber = retry/recovery. DB visibility is by commit and SELECT, not an in-memory message. Open README.md for the source index and linked pages.</bpmn:documentation>
    <bpmn:participant id="fluxbank-transfer-overview_client_pool" name="Client" processRef="fluxbank-transfer-overview_client" />
    <bpmn:participant id="fluxbank-transfer-overview_api_pool" name="FluxBank | synchronous API" processRef="fluxbank-transfer-overview_api" />
    <bpmn:participant id="fluxbank-transfer-overview_worker_pool" name="FluxBank | Outbox worker" processRef="fluxbank-transfer-overview_worker" />
    <bpmn:participant id="fluxbank-transfer-overview_broker_pool" name="Kafka broker" processRef="fluxbank-transfer-overview_broker" />
    <bpmn:participant id="fluxbank-transfer-overview_consumer_pool" name="FluxBank | History consumer" processRef="fluxbank-transfer-overview_consumer" />
    <bpmn:messageFlow id="fluxbank-transfer-overview_Message5" sourceRef="fluxbank-transfer-overview_serviceTask1" targetRef="fluxbank-transfer-overview_serviceTask2" name="HTTP request" />
    <bpmn:messageFlow id="fluxbank-transfer-overview_Message17" sourceRef="fluxbank-transfer-overview_serviceTask14" targetRef="fluxbank-transfer-overview_receiveTask16" name="Publish event" />
    <bpmn:messageFlow id="fluxbank-transfer-overview_Message20" sourceRef="fluxbank-transfer-overview_receiveTask16" targetRef="fluxbank-transfer-overview_serviceTask18" name="Consume event" />
  </bpmn:collaboration>
